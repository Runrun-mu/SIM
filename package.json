{
  "name": "group-dynamics-simulator",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "ci": "bun run lint && bun run typecheck && bun run test",
    "ci:full": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "husky": "^9.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
